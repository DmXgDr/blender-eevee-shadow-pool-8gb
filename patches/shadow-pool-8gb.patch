+/* Exercise all physical addresses and cache indices, including the old 2 GiB boundary. */
+static void test_eevee_shadow_8gb_addresses()
+{
+  for (uint address = 0; address < SHADOW_MAX_PAGE; address++) {
+    const uint3 page = shadow_page_unpack(address);
+    EXPECT_EQ(shadow_page_pack(page), address);
+    ShadowTileData tile = {};
+    tile.page = page;
+    tile.is_allocated = true;
+    tile.is_used = true;
+    tile.do_update = true;
+    ShadowTileData decoded = shadow_tile_unpack(shadow_tile_pack(tile));
+    EXPECT_EQ(decoded.page, page);
+    EXPECT_TRUE(decoded.is_allocated && decoded.is_used && decoded.do_update);
+    tile.is_allocated = false;
+    tile.is_cached = true;
+    tile.cache_index = address;
+    decoded = shadow_tile_unpack(shadow_tile_pack(tile));
+    EXPECT_EQ(decoded.cache_index, address);
+    EXPECT_TRUE(decoded.is_cached && !decoded.is_allocated);
+    for (uint lod = 0; lod < 8; lod++) {
+      ShadowSamplingTile sampling = {};
+      sampling.page = page;
+      sampling.lod = lod;
+      sampling.lod_offset = uint2((1u << lod) - 1u);
+      sampling.is_valid = true;
+      const auto result = shadow_sampling_tile_unpack(shadow_sampling_tile_pack(sampling));
+      EXPECT_EQ(result.page, sampling.page);
+      EXPECT_EQ(result.lod, sampling.lod);
+      EXPECT_EQ(result.lod_offset, sampling.lod_offset);
+      EXPECT_TRUE(result.is_valid);
+    }
+  }
+  /* The complete clipmap offset domain must not overlap the highest page address. */
+  for (uint x = 0; x < 128; x++) {
+    for (uint y = 0; y < 128; y++) {
+      ShadowSamplingTile tile = {};
+      tile.page = uint3(7, 7, 511);
+      tile.lod = 7;
+      tile.lod_offset = uint2(x, y);
+      tile.is_valid = true;
+      const auto result = shadow_sampling_tile_unpack(shadow_sampling_tile_pack(tile));
+      EXPECT_EQ(result.page, tile.page);
+      EXPECT_EQ(result.lod, tile.lod);
+      EXPECT_EQ(result.lod_offset, tile.lod_offset);
+    }
+  }
+}
+DRAW_TEST(eevee_shadow_8gb_addresses)
